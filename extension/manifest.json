{
    "manifest_version": 2,
    "name": "LeetCode SR Tracker",
    "description": "Add LeetCode and NeetCode problems to your spaced repetition tracker with keyboard shortcuts",
    "version": "1.0.0",
    "permissions": [
        "activeTab",
        "storage",
        "*://leetcode.com/*",
        "*://neetcode.io/*"
    ],
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": {
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "128": "icons/icon128.png"
    },
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": [
                "*://leetcode.com/problems/*",
                "*://neetcode.io/problems/*"
            ],
            "js": [
                "content.js"
            ]
        },
        {
            "matches": [
                "http://localhost/*",
                "https://*/*"
            ],
            "js": [
                "auth-content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "commands": {
        "add-problem": {
            "suggested_key": {
                "default": "Alt+1"
            },
            "description": "Add current problem to tracker"
        },
        "rate-1": {
            "suggested_key": {
                "default": "Alt+2"
            },
            "description": "Rate problem as Again (forgot)"
        },
        "rate-2": {
            "suggested_key": {
                "default": "Alt+3"
            },
            "description": "Rate problem as Hard"
        },
        "rate-3": {
            "suggested_key": {
                "default": "Alt+4"
            },
            "description": "Rate problem as Good"
        },
        "rate-4": {
            "suggested_key": {
                "default": "Alt+5"
            },
            "description": "Rate problem as Easy"
        }
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "leetcode-sr@example.com",
            "strict_min_version": "78.0"
        }
    }
}