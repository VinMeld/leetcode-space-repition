{
    "manifest_version": 3,
    "name": "LeetCode SR Tracker",
    "description": "Add LeetCode and NeetCode problems to your spaced repetition tracker with keyboard shortcuts",
    "version": "1.0.0",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "*://leetcode.com/*",
        "*://neetcode.io/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://leetcode.com/problems/*",
                "*://neetcode.io/problems/*"
            ],
            "js": [
                "content.js"
            ]
        },
        {
            "matches": [
                "http://localhost:5173/*"
            ],
            "js": [
                "auth-content.js"
            ]
        }
    ],
    "commands": {
        "add-problem": {
            "suggested_key": {
                "default": "Alt+1"
            },
            "description": "Add current problem to tracker"
        },
        "rate-0": {
            "suggested_key": {
                "default": "Alt+2"
            },
            "description": "Rate problem as 0 (blackout)"
        },
        "rate-3": {
            "suggested_key": {
                "default": "Alt+3"
            },
            "description": "Rate problem as 3 (hard)"
        },
        "rate-4": {
            "suggested_key": {
                "default": "Alt+4"
            },
            "description": "Rate problem as 4 (good)"
        },
        "rate-5": {
            "suggested_key": {
                "default": "Alt+5"
            },
            "description": "Rate problem as 5 (perfect)"
        }
    }
}